# Copy to .env for local development. Never commit .env.
# Port the Rust server listens on.
PORT=8080
# Log filter for the server (tracing EnvFilter syntax).
RUST_LOG=info
# Postgres server. Store tests (`cargo test`) create and drop a database per test on it,
# so the role needs CREATEDB.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
