{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Parent app for Kids Economy: React + TypeScript + Tailwind, built with Vite (ADR-0004).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
